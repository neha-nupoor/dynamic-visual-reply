{
  "$schema": "schema/theme.schema.json",
  "name": "generic",
  "version": 1,
  "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
  "type": {
    "body": 14,
    "small": 13,
    "meta": 12,
    "title": 24,
    "titleCompact": 20,
    "inlineTitle": 18,
    "section": 14,
    "lineHeight": 1.45,
    "titleLineHeight": 1.25,
    "titleTracking": "0"
  },
  "spacingUnit": 4,
  "radius": {
    "control": 2,
    "surface": 0,
    "chip": 2
  },
  "layout": {
    "maxWidth": 1100,
    "cardMinWidth": 220,
    "flowMinWidth": 150,
    "surfacePadding": 12,
    "contentPadding": 16,
    "contentPaddingCompact": 12,
    "inlinePadding": 12
  },
  "control": {
    "minHeight": 32,
    "inputHeight": 32,
    "paddingX": 10,
    "paddingY": 4,
    "inputPadding": [
      4,
      8
    ],
    "focusWidth": 2,
    "focusOffset": 2
  },
  "table": {
    "cellPadding": [
      6,
      8
    ]
  },
  "light": {
    "canvas": "#e9ebee",
    "surface": "#f2f3f5",
    "text": "#000000",
    "muted": "#4b4b4b",
    "divider": "#b8bec6",
    "controlBorder": "#727272",
    "accent": "#000000",
    "onAccent": "#ffffff",
    "selected": "#e0e3e7",
    "hover": "#e5e7eb",
    "success": "#25703f",
    "warning": "#805700",
    "error": "#b02c34",
    "inputFill": "#ffffff",
    "inputFillActive": "#ffffff",
    "inputBorder": "#8a9099"
  },
  "dark": {
    "canvas": "#161616",
    "surface": "#161616",
    "text": "#dedede",
    "muted": "#c4c4c4",
    "divider": "#383838",
    "controlBorder": "#8c8c8c",
    "accent": "#dedede",
    "onAccent": "#161616",
    "selected": "#383838",
    "hover": "#292929",
    "success": "#86d3a0",
    "warning": "#efc56c",
    "error": "#ffa9ae",
    "inputFill": "#292929",
    "inputFillActive": "#161616",
    "inputBorder": "#6c6c6c"
  },
  "label": "Generic"
}
