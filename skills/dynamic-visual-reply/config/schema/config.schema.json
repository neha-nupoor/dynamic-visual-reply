{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dynamic-visual-reply/config.schema.json",
  "title": "Dynamic visual reply configuration layer",
  "description": "Defaults, user, project and command-line settings; later layers override earlier ones.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "theme": {"description": "Theme pack name, a path to a theme.json or pack folder, or an inline theme object.", "type": ["string", "object"]},
    "themeFallback": {"type": "string"},
    "appearance": {"enum": ["light", "dark", "system", "host", null]},
    "harness": {"enum": ["auto", "codex", "claude-inline", "claude-code", "browser-local", "static"]},
    "views": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "array", "uniqueItems": true, "items": {"enum": ["table", "cards", "form", "kanban", "flow"]}}
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"width": {"type": "integer", "minimum": 320}, "height": {"type": "integer", "minimum": 240}}
        },
        "heightBudget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"maxPx": {"type": "integer", "minimum": 120}, "fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}
        },
        "inlineLimits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "table": {"anyOf": [{"const": false}, {"type": "object", "additionalProperties": false, "properties": {"rows": {"type": "integer", "minimum": 0}, "columns": {"type": "integer", "minimum": 0}}}]},
            "cards": {"anyOf": [{"const": false}, {"type": "object", "additionalProperties": false, "properties": {"items": {"type": "integer", "minimum": 0}}}]},
            "form": {"anyOf": [{"const": false}, {"type": "object", "additionalProperties": false, "properties": {"units": {"type": "integer", "minimum": 0}}}]},
            "flow": {"anyOf": [{"const": false}, {"type": "object", "additionalProperties": false, "properties": {"nodes": {"type": "integer", "minimum": 0}}}]},
            "kanban": {"anyOf": [{"const": false}, {"type": "object", "additionalProperties": false, "properties": {"items": {"type": "integer", "minimum": 0}}}]}
          }
        },
        "maxInlineBytes": {"type": "integer", "minimum": 1000},
        "maxSpecBytes": {"type": ["integer", "null"], "minimum": 200}
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rendererUrl": {"type": ["string", "null"], "pattern": "^https://"},
        "repository": {"description": "Public GitHub \"owner/name\" this skill is released from. When rendererUrl is null, the renderer loads from jsDelivr at the release tag (v + bundle version).", "type": ["string", "null"], "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "integrity": {"description": "\"manifest\" computes SRI from the local bundle, a literal sha384-… value pins one, null omits it.", "type": ["string", "null"]}
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultPrompt": {"type": "string"},
        "formPrompt": {"type": "string"},
        "messageFormat": {"description": "How Send to chat writes the message: pretty JSON, one-line JSON, or a readable summary line followed by one-line JSON.", "enum": ["json", "compact", "summary"]}
      }
    },
    "copy": {"description": "User-facing strings. Partial objects are merged over the defaults.", "type": "object"}
  }
}
