{
  "$schema": "./schema/config.schema.json",
  "theme": "neutral",
  "themeFallback": "neutral",
  "appearance": null,
  "harness": "auto",
  "views": {
    "enabled": [
      "table",
      "cards",
      "form",
      "kanban",
      "flow"
    ],
    "motion": true
  },
  "placement": {
    "viewport": {
      "width": 736,
      "height": 900
    },
    "heightBudget": {
      "maxPx": 640,
      "fraction": 0.75
    },
    "inlineLimits": {
      "table": {
        "rows": 3,
        "columns": 3
      },
      "cards": {
        "items": 2
      },
      "form": {
        "units": 3
      },
      "flow": {
        "nodes": 4
      },
      "kanban": false,
      "motion": false
    },
    "maxInlineBytes": 1000000,
    "maxSpecBytes": null
  },
  "delivery": {
    "mode": "embed",
    "rendererUrl": null,
    "repository": "neha-nupoor/reply-ui",
    "repositoryPath": "skills/visual-response-design",
    "tagPrefix": "v",
    "integrity": "manifest"
  },
  "output": {
    "inline": "fragment",
    "standalone": "document"
  },
  "feedback": {
    "defaultPrompt": "Review my batch feedback and continue the task.",
    "formPrompt": "Use my form answers and continue the task.",
    "messageFormat": "json"
  },
  "copy": {
    "badge": "Draft → preview → feedback",
    "goal": "Goal:",
    "next": "Next:",
    "submit": {
      "message": "Send to chat",
      "save": "Save feedback",
      "saveForm": "Save answers",
      "none": "Prepare message",
      "busy": "Sending…"
    },
    "feedbackSubmit": {
      "message": "Send feedback",
      "save": "Save feedback",
      "none": "Prepare feedback"
    },
    "feedbackSection": "Feedback and actions",
    "generalInstruction": "General instruction",
    "instruction": "Instruction",
    "reviewed": "Reviewed",
    "select": "Select",
    "selected": "Selected",
    "recommended": "Recommended",
    "moreDetail": "More detail",
    "source": "Source",
    "preview": "Preview batch",
    "hidePreview": "Hide preview",
    "copy": "Copy feedback",
    "export": "Export JSON",
    "undo": "Undo edit",
    "previewNote": "Includes selected items and items with edits or comments. No real task state changes until the agent acts.",
    "editableMessage": "Editable message to the agent",
