{
  "$schema": "../config/schema/harness.schema.json",
  "id": "browser-local",
  "label": "Local browser panel (serve.py)",
  "adapter": "browser-local.js",
  "handoff": "serve",
  "references": "references/harness/browser-local.md",
  "notes": "Works for any agent that can run Python and open a browser. Saving writes <output>.feedback.json through serve.py; it does not start an agent turn.",
  "config": {
    "delivery": {"mode": "embed"},
    "output": {"inline": "document", "standalone": "document"},
    "placement": {"inlineLimits": {"table": false, "cards": false, "form": false, "flow": false, "kanban": false, "motion": false}}
  }
}
