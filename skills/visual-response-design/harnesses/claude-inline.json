{
  "$schema": "../config/schema/harness.schema.json",
  "id": "claude-inline",
  "label": "Claude app inline widget (show_widget)",
  "detect": {"env": {"CLAUDECODE": "1", "CLAUDE_CODE_DESKTOP_APP_VERSION": "*"}, "priority": 20},
  "adapter": "claude-inline.js",
  "standaloneHarness": "claude-artifact",
  "standaloneFallback": "browser-local",
  "handoff": "show_widget",
  "references": "references/harness/claude-inline.md",
  "csp": {"scriptHosts": ["cdnjs.cloudflare.com", "esm.sh", "cdn.jsdelivr.net", "unpkg.com"]},
  "hostPalette": {
    "canvas": "--surface-0",
    "surface": "--surface-2",
    "text": "--text-primary",
    "muted": "--text-secondary",
    "divider": "--border",
    "controlBorder": "--border-strong",
    "accent": "--fill-accent",
    "onAccent": "--on-accent",
    "selected": "--bg-accent",
    "hover": "--surface-1",
    "success": "--text-success",
    "warning": "--text-warning",
    "error": "--text-danger"
  },
  "notes": "show_widget takes the widget's code as model-written text, so the bundle is loaded from rendererUrl and only the spec, theme and this adapter are written per view. Send to chat calls the widget's global sendPrompt().",
  "config": {
    "delivery": {"mode": "url"},
    "output": {"inline": "fragment"},
    "placement": {"viewport": {"width": 680, "height": 900}, "maxSpecBytes": 24000},
    "copy": {"status": {"submitted": "Sent to chat."}}
  }
}
