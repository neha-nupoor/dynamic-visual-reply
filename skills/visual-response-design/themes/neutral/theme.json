{
  "$schema": "../../config/schema/theme.schema.json",
  "name": "neutral",
  "version": 1,
  "appearance": "light",
  "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
  "type": {
    "body": 15,
    "small": 14,
    "meta": 12,
    "title": 28,
    "titleCompact": 24,
    "inlineTitle": 20,
    "section": 18,
    "lineHeight": 1.5,
    "titleLineHeight": 1.2,
    "titleTracking": "-0.02em"
  },
  "spacingUnit": 8,
  "radius": {
    "control": 6,
    "surface": 10,
    "chip": 6
  },
  "layout": {
    "maxWidth": 1100,
    "cardMinWidth": 220,
    "flowMinWidth": 150,
    "surfacePadding": 20,
    "contentPadding": 24,
    "contentPaddingCompact": 16,
    "inlinePadding": 16
  },
  "control": {
    "minHeight": 40,
    "inputHeight": 44,
    "paddingX": 14,
    "paddingY": 8,
    "inputPadding": [
      10,
      12
    ],
    "focusWidth": 2,
    "focusOffset": 2
  },
  "table": {
    "cellPadding": [
      10,
      10
    ]
  },
  "light": {
    "canvas": "#f5f6f7",
    "surface": "#ffffff",
    "text": "#1d2024",
    "muted": "#56606c",
    "divider": "#e1e4e8",
    "controlBorder": "#7a828e",
    "accent": "#2a62c9",
    "onAccent": "#ffffff",
    "selected": "#eef3fc",
    "hover": "#f0f2f5",
    "success": "#25703f",
    "warning": "#805700",
    "error": "#b02c34"
  },
  "dark": {
    "canvas": "#0b0c0e",
    "surface": "#141519",
    "text": "#eceef2",
    "muted": "#9da3ae",
    "divider": "#26282e",
    "controlBorder": "#6c727e",
    "accent": "#5e8bdb",
    "onAccent": "#0b1433",
    "accentFill": "#335ba3",
    "onAccentFill": "#ffffff",
    "accentBorder": "#3f6ec5",
    "selected": "#182946",
    "onSelected": "#d1dff6",
    "hover": "#1d1f24",
    "success": "#6fcf97",
    "warning": "#e8c06a",
    "error": "#ff8a90"
  }
}
