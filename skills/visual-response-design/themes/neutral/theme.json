{
  "$schema": "../../config/schema/theme.schema.json",
  "name": "neutral",
  "version": 1,
  "appearance": "light",
  "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
  "type": {
    "body": 15,
    "small": 14,
    "meta": 12,
    "title": 28,
    "titleCompact": 24,
    "inlineTitle": 20,
    "section": 18,
    "lineHeight": 1.5,
    "titleLineHeight": 1.2,
    "titleTracking": "-0.02em"
  },
  "spacingUnit": 8,
  "radius": {
    "control": 2,
    "surface": 0,
    "chip": 2
  },
  "layout": {
    "maxWidth": 1100,
    "cardMinWidth": 220,
    "flowMinWidth": 150,
    "surfacePadding": 20,
    "contentPadding": 24,
    "contentPaddingCompact": 16,
    "inlinePadding": 16
  },
  "control": {
    "minHeight": 40,
    "inputHeight": 44,
    "paddingX": 14,
    "paddingY": 8,
    "inputPadding": [
      10,
      12
    ],
    "focusWidth": 2,
    "focusOffset": 2
  },
  "table": {
    "cellPadding": [
      10,
      10
    ]
  },
  "light": {
    "canvas": "#e9ebee",
    "surface": "#f2f3f5",
    "text": "#000000",
    "muted": "#4b4b4b",
    "divider": "#b8bec6",
    "controlBorder": "#727272",
    "accent": "#000000",
    "onAccent": "#ffffff",
    "selected": "#e0e3e7",
    "hover": "#e5e7eb",
    "success": "#25703f",
    "warning": "#805700",
    "error": "#b02c34",
    "inputFill": "#ffffff",
    "inputFillActive": "#ffffff",
    "inputBorder": "#8a9099"
  },
  "dark": {
    "canvas": "#161616",
    "surface": "#161616",
    "text": "#dedede",
    "muted": "#c4c4c4",
    "divider": "#383838",
    "controlBorder": "#8c8c8c",
    "accent": "#dedede",
    "onAccent": "#161616",
    "selected": "#383838",
    "hover": "#292929",
    "success": "#86d3a0",
    "warning": "#efc56c",
    "error": "#ffa9ae",
    "inputFill": "#292929",
    "inputFillActive": "#161616",
    "inputBorder": "#6c6c6c"
  }
}
